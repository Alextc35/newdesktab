{
  "name": "newdesktab",
  "version": "0.28.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:unit && npm run test:dom",
    "test:unit": "node --test tests/*.test.mjs",
    "test:dom": "vitest run",
    "test:e2e": "playwright test",
    "test:extension": "node tests/extension-smoke.mjs",
    "assets:store": "node scripts/generate-store-assets.mjs",
    "vendor:zip": "node scripts/vendor-backup-zip.mjs",
    "package:store": "python3 scripts/package-extension.py",
    "lint": "eslint .",
    "check": "npm run lint && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@zip.js/zip.js": "2.23.0",
    "esbuild": "0.28.2",
    "eslint": "^10.8.1",
    "globals": "^17.9.0",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.11"
  }
}
